<Window x:Class="NewsDesk.Desktop.Views.ProjectEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NewsDesk.Desktop.ViewModels"
        Title="{Binding Title}" Width="760" Height="820" MinWidth="600" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Bg}">
    <DockPanel>
        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Content="Cancel" IsCancel="True" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Save" Click="OnSave" Margin="0" />
                </StackPanel>
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,16,28,24">
                <!-- Purpose -->
                <TextBlock Style="{StaticResource H2}" Text="Purpose" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Project name" />
                <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Project name" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Description (optional)" />
                <TextBox Text="{Binding Description}" AutomationProperties.Name="Description" />

                <!-- Matching -->
                <TextBlock Style="{StaticResource H2}" Text="Matching" Margin="0,24,0,0" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Include topics — one per line" />
                <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,6"
                           Text="Use | for aliases, e.g. “Arcade1Up | A1Up”. Multi-word terms match as exact phrases. Leave empty to include everything from your sources." />
                <TextBox Text="{Binding IncludeTerms}" AcceptsReturn="True" MinHeight="80" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Include topics" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <RadioButton Content="Match any topic" IsChecked="{Binding MatchAll, Converter={x:Static vm:InverseBool.Instance}}" Margin="0,0,20,0" Foreground="{DynamicResource Text}" />
                    <RadioButton Content="Require every topic" IsChecked="{Binding MatchAll}" Foreground="{DynamicResource Text}" />
                </StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Exclude — one per line" />
                <TextBox Text="{Binding ExcludeTerms}" AcceptsReturn="True" MinHeight="56" TextWrapping="Wrap" AutomationProperties.Name="Exclusions" />

                <!-- Curation -->
                <TextBlock Style="{StaticResource H2}" Text="Briefing" Margin="0,24,0,0" />
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Items per briefing" />
                        <TextBox Text="{Binding TopN}" AutomationProperties.Name="Items per briefing" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Look back (hours)" />
                        <TextBox Text="{Binding WindowHours}" AutomationProperties.Name="Look back hours" ToolTip="24 = last day, 168 = last week" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Minimum score (0–100)" />
                        <TextBox Text="{Binding ScoreFloor}" AutomationProperties.Name="Minimum score" />
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <RadioButton Content="Top articles" IsChecked="{Binding StoriesMode, Converter={x:Static vm:InverseBool.Instance}}" Margin="0,0,20,0" Foreground="{DynamicResource Text}" />
                    <RadioButton Content="Top distinct stories (groups reports about the same CVE)" IsChecked="{Binding StoriesMode}" Foreground="{DynamicResource Text}" />
                </StackPanel>
                <CheckBox Content="Repeat items already delivered in earlier briefings" IsChecked="{Binding IncludePreviouslySeen}" Margin="0,10,0,0" Foreground="{DynamicResource Text}" />
                <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0"
                           Text="Score = 50% topic relevance + 25% freshness + 15% source priority + 10% primary source. It is a ranking aid, not a quality guarantee." />

                <!-- Schedule -->
                <TextBlock Style="{StaticResource H2}" Text="Schedule" Margin="0,24,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ComboBox ItemsSource="{Binding ScheduleKinds}" SelectedItem="{Binding ScheduleKind}" Width="160" AutomationProperties.Name="Schedule type" />
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" Visibility="{Binding ShowTime, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="at" VerticalAlignment="Center" Foreground="{DynamicResource Text}" Margin="0,0,8,0" />
                        <TextBox Text="{Binding TimeOfDay}" Width="80" AutomationProperties.Name="Time of day" ToolTip="HH:MM, local time" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" Visibility="{Binding ShowInterval, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="every" VerticalAlignment="Center" Foreground="{DynamicResource Text}" Margin="0,0,8,0" />
                        <TextBox Text="{Binding IntervalMinutes}" Width="70" AutomationProperties.Name="Interval minutes" />
                        <TextBlock Text="minutes (minimum 15)" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Days}" Margin="0,10,0,0" Visibility="{Binding ShowDays, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DayOption}">
                            <ToggleButton Content="{Binding Label}" IsChecked="{Binding IsSelected}" Width="52" Margin="0,0,6,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <CheckBox Content="Enabled (scheduled runs happen while background collection is on)" IsChecked="{Binding Enabled}" Margin="0,12,0,0" Foreground="{DynamicResource Text}" />

                <!-- Retention -->
                <TextBlock Style="{StaticResource H2}" Text="Retention" Margin="0,24,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Keep unreviewed items for" VerticalAlignment="Center" Foreground="{DynamicResource Text}" Margin="0,0,8,0" />
                    <TextBox Text="{Binding RetentionDays}" Width="60" AutomationProperties.Name="Retention days" />
                    <TextBlock Text="days. Kept items and notes are never removed automatically." VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="8,0,0,0" />
                </StackPanel>

                <!-- Preview -->
                <TextBlock Style="{StaticResource H2}" Text="Rule preview" Margin="0,24,0,0" />
                <TextBlock Style="{StaticResource MutedText}" Text="{Binding PreviewText}" Margin="0,4,0,8" />
                <Button Style="{StaticResource ToolButton}" Content="Preview with current rules" HorizontalAlignment="Left" Command="{Binding PreviewCommand}"
                        IsEnabled="{Binding CanPreview}" />
                <ItemsControl ItemsSource="{Binding PreviewItems}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Body}" FontSize="13" Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
