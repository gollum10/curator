<Window x:Class="NewsDesk.Desktop.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{DynamicResource Bg}">
    <StackPanel Margin="24,20">
        <TextBlock x:Name="MessageText" Style="{StaticResource Body}" Margin="0,0,0,10" />
        <TextBox x:Name="Input" AutomationProperties.Name="Name" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource ToolButton}" Content="Cancel" IsCancel="True" />
            <Button Style="{StaticResource PrimaryButton}" Content="OK" IsDefault="True" Click="OnOk" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
