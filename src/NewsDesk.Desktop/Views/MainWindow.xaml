<Window x:Class="NewsDesk.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NewsDesk.Desktop.ViewModels"
        xmlns:views="clr-namespace:NewsDesk.Desktop.Views"
        Title="Personal News Desk" Width="1360" Height="860" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}" />
        <KeyBinding Key="H" Modifiers="Control" Command="{Binding ShowHomeCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- Home page -->
        <DataTemplate DataType="{x:Type vm:MainViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24">
                <StackPanel>
                    <DockPanel Margin="0,0,0,20">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource ToolButton}" Content="Refresh all" Command="{Binding RefreshAllCommand}"
                                    IsEnabled="{Binding HasProjects}" ToolTip="Collect now for every enabled project" />
                            <Button Style="{StaticResource PrimaryButton}" Content="+ New project" Command="{Binding NewProjectCommand}" ToolTip="Ctrl+N" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource H1}" Text="Home" />
                            <TextBlock Style="{StaticResource MutedText}" Text="Your projects, what is new, and anything that needs attention." />
                        </StackPanel>
                    </DockPanel>

                    <!-- Empty state -->
                    <Border Style="{StaticResource Card}" MaxWidth="620" HorizontalAlignment="Left" Padding="24"
                            Visibility="{Binding HasProjects, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="Create your first project" />
                            <TextBlock Style="{StaticResource Body}" Margin="0,8,0,16"
                                       Text="A project collects from the websites you choose, filters by your topics, and prepares a short briefing — for example, the top 5 articles about a product release, or the top 5 distinct security risks for your technology." />
                            <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Content="+ New project" Command="{Binding NewProjectCommand}" />
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Tiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProjectTile}">
                                <Button Width="300" Margin="0,0,16,16" Padding="0" Cursor="Hand" HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.OpenTileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Style="{StaticResource Card}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                    <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding Description}" Margin="0,2,0,12" MaxHeight="36" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Text="{Binding NewItems}" />
                                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding LastBriefing}" Margin="0,8,0,0" />
                                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding NextRun}" />
                                        <Border Style="{StaticResource WarningBanner}" Margin="0,10,0,0" Padding="8,4"
                                                Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Foreground="{DynamicResource Warning}" FontSize="12.5" Text="{Binding Warning, StringFormat=⚠ {0}}" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProjectViewModel}">
            <views:ProjectView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Navigation -->
        <Border Grid.RowSpan="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,16,12,12">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Personal News Desk" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Text}" Margin="8,0,0,16" />
                    <Button Style="{StaticResource ToolButton}" HorizontalContentAlignment="Left" BorderThickness="0" Padding="10,8" Margin="0"
                            Command="{Binding ShowHomeCommand}" ToolTip="Ctrl+H">
                        <Button.Content>
                            <TextBlock Text="⌂  Home" FontWeight="SemiBold" />
                        </Button.Content>
                    </Button>
                    <DockPanel Margin="8,16,0,4">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Padding="6,0" Margin="0" BorderThickness="0"
                                Content="+" FontSize="16" Command="{Binding NewProjectCommand}" ToolTip="New project (Ctrl+N)"
                                AutomationProperties.Name="New project" />
                        <TextBlock Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center" Text="PROJECTS" />
                    </DockPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Separator Margin="0,8" Background="{DynamicResource Border}" />
                    <Button Style="{StaticResource ToolButton}" HorizontalContentAlignment="Left" BorderThickness="0" Margin="0,1"
                            Command="{Binding RefreshDueCommand}" Content="⟳  Run due projects" ToolTip="Run scheduled projects that are due now" />
                    <Button Style="{StaticResource ToolButton}" HorizontalContentAlignment="Left" BorderThickness="0" Margin="0,1"
                            Command="{Binding ToggleBackgroundCommand}" Content="{Binding BackgroundLabel}"
                            ToolTip="Register or remove a Windows scheduled task that checks due projects every 15 minutes while you are signed in" />
                    <Button Style="{StaticResource ToolButton}" HorizontalContentAlignment="Left" BorderThickness="0" Margin="0,1"
                            Command="{Binding ToggleThemeCommand}" Content="{Binding ThemeLabel}" />
                    <Button Style="{StaticResource ToolButton}" HorizontalContentAlignment="Left" BorderThickness="0" Margin="0,1"
                            Command="{Binding OpenDataFolderCommand}" Content="🗀  Data folder" ToolTip="Open the folder that holds your local database and logs" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" BorderThickness="0" Background="Transparent"
                         ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Projects">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProjectNavItem}">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="{DynamicResource Accent}" CornerRadius="9" MinWidth="20" Padding="6,0"
                                        Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Unread}" Foreground="{DynamicResource OnAccent}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock DockPanel.Dock="Right" Text="⚠" Foreground="{DynamicResource Warning}" Margin="0,0,6,0" ToolTip="A source needs attention"
                                           Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text}" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False" />

        <!-- Status bar -->
        <Border Grid.Column="1" Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16,5">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" Width="120" Height="4" IsIndeterminate="True" VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock Style="{StaticResource MutedText}" Text="{Binding Status}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
