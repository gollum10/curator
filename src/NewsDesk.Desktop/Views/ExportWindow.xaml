<Window x:Class="NewsDesk.Desktop.Views.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export" Width="980" Height="680" MinWidth="700" MinHeight="450"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Bg}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Content="Copy to clipboard" Command="{Binding CopyCommand}" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Save file…" Command="{Binding SaveCommand}" />
                    <Button Style="{StaticResource ToolButton}" Content="Close" IsCancel="True" Click="OnClose" Margin="0" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Success}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding Disclosure}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="{Binding Title}" />
                <TextBlock Style="{StaticResource MutedText}" Text="{Binding CountLabel}" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Format" Margin="0,20,0,4" />
                <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" DisplayMemberPath="Label" AutomationProperties.Name="Format" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Include" />
                <ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding SelectedScope}" DisplayMemberPath="Label" AutomationProperties.Name="Content to include" />
                <TextBlock Style="{StaticResource MutedText}" Margin="0,16,0,0"
                           Text="Every format keeps the publisher name, dates, and a link to the original. Full text is included only where the source's feed supplied it." />
            </StackPanel>
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" Text="PREVIEW" />
                <TextBox Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" AutomationProperties.Name="Export preview" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
