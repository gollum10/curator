<UserControl x:Class="NewsDesk.Desktop.Views.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NewsDesk.Desktop.ViewModels">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding ToggleKeepCommand}" />
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding DismissCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="U" Modifiers="Control" Command="{Binding ToggleReadCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenOriginalCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportSelectedCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveAnnotationsCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="24,16,24,12">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButton}" Content="⟳ Refresh" Command="{Binding RefreshCommand}" ToolTip="Collect now (F5)"
                                Visibility="{Binding IsRefreshing, Converter={StaticResource InverseBoolToVis}}" />
                        <Button Style="{StaticResource ToolButton}" Content="Cancel" Command="{Binding CancelRefreshCommand}"
                                Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource ToolButton}" Content="Export view…" Command="{Binding ExportViewCommand}"
                                ToolTip="Export everything in the current view" />
                        <Button Style="{StaticResource ToolButton}" Content="⚙ Settings" Command="{Binding EditSettingsCommand}"
                                ToolTip="Matching rules, curation, schedule and retention" />
                        <Button Style="{StaticResource ToolButton}" Content="Delete" Foreground="{DynamicResource Danger}" Margin="0"
                                Command="{Binding DataContext.DeleteProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource H1}" Text="{Binding Name}" />
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding HeaderDetails}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,8,0,0" Visibility="{Binding ProgressText, Converter={StaticResource NullToCollapsed}}">
                    <ProgressBar DockPanel.Dock="Left" Width="80" Height="4" Margin="0,0,10,0" IsIndeterminate="True" VerticalAlignment="Center"
                                 Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding ProgressText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </DockPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="400" MinWidth="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- View selector -->
            <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Padding="8,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ListBox ItemsSource="{Binding Views}" SelectedItem="{Binding SelectedFixedView}" BorderThickness="0" Background="Transparent"
                                 ItemContainerStyle="{StaticResource NavItem}" AutomationProperties.Name="Project views"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DeskViewOption}">
                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Text}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <DockPanel Margin="10,16,0,4">
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Padding="6,0" Margin="0" BorderThickness="0"
                                    Content="+" FontSize="15" Command="{Binding NewCollectionCommand}" ToolTip="New collection"
                                    AutomationProperties.Name="New collection" />
                            <TextBlock Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center" Text="COLLECTIONS" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource MutedText}" Margin="10,2,4,0" FontSize="12"
                                   Text="Group items for an episode, report, or meeting."
                                   Visibility="{Binding HasCollections, Converter={StaticResource InverseBoolToVis}}" />
                        <ListBox ItemsSource="{Binding Collections}" SelectedItem="{Binding SelectedCollectionOption}" BorderThickness="0" Background="Transparent"
                                 ItemContainerStyle="{StaticResource NavItem}" AutomationProperties.Name="Collections"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DeskViewOption}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="6,0,0,0" />
                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===================== Article list ===================== -->
            <DockPanel Grid.Column="1" Background="{DynamicResource Surface}" Visibility="{Binding IsArticlesView, Converter={StaticResource BoolToVis}}">
                <!-- Briefing header -->
                <Border DockPanel.Dock="Top" Padding="14,12" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                        Visibility="{Binding IsBriefingView, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" FontSize="14.5" Text="{Binding BriefingTitle}" />
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding BriefingMeta}" Margin="0,2,0,0" />
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding BriefingSummary}" Margin="0,6,0,0" />
                        <Border Style="{StaticResource WarningBanner}" Margin="0,8,0,0" Visibility="{Binding HasBriefingWarnings, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Source problems — this briefing may be incomplete" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource Warning}" />
                                <ItemsControl ItemsSource="{Binding BriefingWarnings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat=• {0}}" FontSize="12" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Collection header -->
                <Border DockPanel.Dock="Top" Padding="14,12" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                        Visibility="{Binding IsCollectionView, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" FontSize="14.5" Text="{Binding SelectedCollectionName}" />
                        <TextBlock Style="{StaticResource MutedText}" Text="Collection · in the order items were added" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource ToolButton}" Content="Export…" Command="{Binding ExportViewCommand}" Padding="10,3" />
                            <Button Style="{StaticResource ToolButton}" Content="Rename" Command="{Binding RenameCollectionCommand}" Padding="10,3" />
                            <Button Style="{StaticResource ToolButton}" Content="Delete collection" Command="{Binding DeleteCollectionCommand}" Padding="10,3" Margin="0"
                                    Foreground="{DynamicResource Danger}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Search -->
                <Border DockPanel.Dock="Top" Padding="12,10" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                        Visibility="{Binding ShowSearch, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                 AutomationProperties.Name="Search this view" ToolTip="Search titles and text (Ctrl+F)" />
                        <TextBlock Text="Search…" Foreground="{DynamicResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <Grid>
                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding EmptyText}" Margin="24" HorizontalAlignment="Center" TextAlignment="Center"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                    <ListBox x:Name="ItemList" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource ArticleRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" AutomationProperties.Name="Articles">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ItemViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Rank or unread marker -->
                                    <Grid Width="28" VerticalAlignment="Top" Margin="0,1,6,0">
                                        <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource Accent}" HorizontalAlignment="Left"
                                                Visibility="{Binding HasRank, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding RankLabel}" Foreground="{DynamicResource OnAccent}" FontWeight="Bold" FontSize="12"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Accent}" HorizontalAlignment="Left" Margin="6,6,0,0" ToolTip="Unread">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsRead}" Value="False" />
                                                                <Condition Binding="{Binding HasRank}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Grid>
                                    <StackPanel Grid.Column="1">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="★" Foreground="{DynamicResource Warning}" Margin="6,0,0,0" ToolTip="Kept"
                                                       Visibility="{Binding IsKept, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource Text}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRead}" Value="True">
                                                                <Setter Property="FontWeight" Value="Normal" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding Subline}" Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding Excerpt}" Margin="0,4,0,0" MaxHeight="34" TextTrimming="WordEllipsis"
                                                   Foreground="{DynamicResource Text}" Opacity="0.8" />
                                        <WrapPanel Margin="0,6,0,0">
                                            <Border Style="{StaticResource Chip}" Background="{DynamicResource WarningSoft}" Visibility="{Binding IsUpdate, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Updated" FontSize="11.5" Foreground="{DynamicResource Warning}" />
                                            </Border>
                                            <Border Style="{StaticResource Chip}" Visibility="{Binding HasSupporting, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding SupportingLabel}" FontSize="11.5" Foreground="{DynamicResource Muted}" />
                                            </Border>
                                            <Border Style="{StaticResource Chip}" Visibility="{Binding HasRank, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding Reason}" FontSize="11.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="2" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource Border}" ResizeBehavior="PreviousAndNext"
                          Visibility="{Binding IsArticlesView, Converter={StaticResource BoolToVis}}" Focusable="False" />

            <!-- ===================== Reading pane ===================== -->
            <Grid Grid.Column="3" Background="{DynamicResource Bg}" Visibility="{Binding IsArticlesView, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource MutedText}" Text="Select an item to read it." HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding SelectedItem}"
                              Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="32,24" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource Text}" />
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding Subline}" Margin="0,8,0,0" FontSize="13" />
                        <WrapPanel Margin="0,8,0,0">
                            <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding Coverage}" FontSize="12" Foreground="{DynamicResource Muted}" /></Border>
                            <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding StateLabel}" FontSize="12" Foreground="{DynamicResource Muted}" /></Border>
                            <TextBlock Style="{StaticResource MutedText}" Text="{Binding CapturedLabel}" VerticalAlignment="Center" />
                        </WrapPanel>

                        <!-- Actions -->
                        <WrapPanel Margin="0,16,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Button Style="{StaticResource ToolButton}" Content="{Binding SelectedItem.KeepLabel}" Command="{Binding ToggleKeepCommand}" ToolTip="Keep (Ctrl+K)" Margin="0,0,6,6" />
                            <Button Style="{StaticResource ToolButton}" Content="Dismiss" Command="{Binding DismissCommand}" ToolTip="Dismiss (Ctrl+D) — undo with Ctrl+Z" Margin="0,0,6,6"
                                    Visibility="{Binding SelectedItem.IsDismissed, Converter={StaticResource InverseBoolToVis}}" />
                            <Button Style="{StaticResource ToolButton}" Content="Restore" Command="{Binding RestoreCommand}" Margin="0,0,6,6"
                                    Visibility="{Binding SelectedItem.IsDismissed, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource ToolButton}" Content="Mark unread" Command="{Binding ToggleReadCommand}" ToolTip="Toggle read (Ctrl+U)" Margin="0,0,6,6" />
                            <Button Style="{StaticResource ToolButton}" Content="Open original ↗" Command="{Binding OpenOriginalCommand}" ToolTip="Open in your browser (Ctrl+O)" Margin="0,0,6,6" />
                            <Button Style="{StaticResource ToolButton}" Content="Export…" Command="{Binding ExportSelectedCommand}" ToolTip="Export this item (Ctrl+E)" Margin="0,0,6,6" />
                        </WrapPanel>

                        <!-- Why -->
                        <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,10,0,0" Visibility="{Binding HasReason, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionLabel}" Margin="0,0,0,2" Text="WHY THIS ITEM" />
                                <TextBlock Style="{StaticResource Body}" FontSize="13" Text="{Binding Reason}" />
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" Text="{Binding GroupKey, StringFormat=Identifiers: {0}}"
                                           Visibility="{Binding HasGroupKey, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>

                        <!-- Collections -->
                        <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,4,0,0">
                            <TextBlock Style="{StaticResource SectionLabel}" Text="COLLECTIONS" />
                            <WrapPanel>
                                <ItemsControl ItemsSource="{Binding ItemCollections}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:CollectionMembership}">
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsMember}" Margin="0,0,16,6" Foreground="{DynamicResource Text}"
                                                      AutomationProperties.Name="{Binding Name, StringFormat=In collection {0}}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource ToolButton}" Content="+ New collection with this item" Padding="10,3" Margin="0,0,0,6"
                                        Command="{Binding NewCollectionWithItemCommand}" />
                            </WrapPanel>
                        </StackPanel>

                        <!-- Content (plain text only; publisher HTML is never rendered) -->
                        <TextBox Text="{Binding ReaderText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource Text}" FontSize="15" Margin="0,18,0,0" Padding="0"
                                 AutomationProperties.Name="Article text" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0"
                                   Text="Text shown is what the source's feed provided. Open the original for the complete article and images." />

                        <!-- Related coverage -->
                        <StackPanel Visibility="{Binding HasSupporting, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource SectionLabel}" Text="RELATED COVERAGE" />
                            <ItemsControl ItemsSource="{Binding Supporting}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ToolButton}" HorizontalContentAlignment="Left" Margin="0,0,0,4" HorizontalAlignment="Stretch"
                                                Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Url}" ToolTip="{Binding Url}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding SourceTitle}" Style="{StaticResource MutedText}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Notes and tags -->
                        <TextBlock Style="{StaticResource SectionLabel}" Text="YOUR NOTES" />
                        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                                 VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Notes" />
                        <TextBlock Style="{StaticResource SectionLabel}" Text="TAGS (comma separated)" />
                        <TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Tags" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,24">
                            <Button Style="{StaticResource ToolButton}" Content="Save notes and tags" ToolTip="Ctrl+S — also saved automatically when you move to another item"
                                    Command="{Binding DataContext.SaveAnnotationsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <TextBlock Style="{StaticResource MutedText}" Text="Unsaved changes" VerticalAlignment="Center"
                                       Visibility="{Binding HasUnsavedAnnotations, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===================== History ===================== -->
            <Grid Grid.Column="1" Grid.ColumnSpan="3" Background="{DynamicResource Bg}" Visibility="{Binding IsHistoryView, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <DockPanel Background="{DynamicResource Surface}">
                    <Border DockPanel.Dock="Top" Padding="14,12" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" FontSize="14.5" Text="Run history" />
                            <TextBlock Style="{StaticResource MutedText}" Text="Every collection and briefing, newest first. Cleanup keeps the latest ten and anything within the retention period." />
                        </StackPanel>
                    </Border>
                    <Grid>
                        <TextBlock Style="{StaticResource MutedText}" Text="No runs yet. Refresh to create the first briefing." Margin="20" TextAlignment="Center"
                                   Visibility="{Binding HasNoRuns, Converter={StaticResource BoolToVis}}" />
                        <ListBox ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}" BorderThickness="0" Background="Transparent"
                                 ItemContainerStyle="{StaticResource ArticleRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Runs">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RunRowViewModel}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" CornerRadius="10" Padding="8,1" VerticalAlignment="Top">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource WarningSoft}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="11.5">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Success}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding When}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
                                            <TextBlock Style="{StaticResource MutedText}" Text="{Binding Subline}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelectedRun, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="28,20" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource H2}" Text="{Binding RunTitle}" />
                        <TextBlock Style="{StaticResource Body}" FontSize="13" Text="{Binding RunSummary}" Margin="0,6,0,0" />
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding RunRules}" Margin="0,6,0,0" />

                        <TextBlock Style="{StaticResource SectionLabel}" Text="SOURCES IN THIS RUN" Margin="0,18,0,6" />
                        <ItemsControl ItemsSource="{Binding RunOutcomes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SourceOutcomeRow}">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Source}" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Outcome}" Margin="0,0,10,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Success}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Style="{StaticResource MutedText}" Text="{Binding Detail}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="BRIEFING" Margin="0,18,0,2" />
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding RunEntriesNote}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding RunEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ItemViewModel}">
                                    <Button Style="{StaticResource ToolButton}" HorizontalContentAlignment="Stretch" Margin="0,0,0,6" Padding="12,8"
                                            Command="{Binding DataContext.OpenRunEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="{Binding Url}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource Accent}" Margin="0,0,10,0" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding RankLabel}" Foreground="{DynamicResource OnAccent}" FontWeight="Bold" FontSize="12"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding Subline}" />
                                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding Reason}" />
                                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding SupportingLabel}"
                                                           Visibility="{Binding HasSupporting, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===================== Sources ===================== -->
            <ScrollViewer Grid.Column="1" Grid.ColumnSpan="3" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Bg}"
                          Visibility="{Binding IsSourcesView, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="28,20" MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource H2}" Text="Add a source" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,8"
                               Text="Enter a website or feed address. The app reports which feeds it can actually collect; it never adds other websites on its own." />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Find feeds" Command="{Binding DiscoverCommand}" Margin="8,0,0,0" IsDefault="False" />
                        <TextBox Text="{Binding NewSourceUrl, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Website or feed address">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding DiscoverCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding DiscoveryMessage}" Margin="0,8,0,0"
                               Visibility="{Binding DiscoveryMessage, Converter={StaticResource NullToCollapsed}}" />

                    <ItemsControl ItemsSource="{Binding DiscoveredFeeds}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FeedOptionViewModel}">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Follow" VerticalAlignment="Top"
                                                Command="{Binding DataContext.AddFeedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource H2}" FontSize="14" Text="{Binding Title}" />
                                            <TextBlock Style="{StaticResource MutedText}" Text="{Binding FeedUrl}" />
                                            <TextBlock Style="{StaticResource MutedText}" Text="{Binding EntryCount}" Margin="0,6,0,2" FontWeight="SemiBold" />
                                            <ItemsControl ItemsSource="{Binding Preview}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding StringFormat=• {0}}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource H2}" Text="Following" Margin="0,24,0,8" />
                    <TextBlock Style="{StaticResource MutedText}" Text="No sources yet. Add a website or feed above."
                               Visibility="{Binding HasNoSources, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding Sources}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SourceRowViewModel}">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Style="{StaticResource ToolButton}" Content="Test" ToolTip="Fetch now and report the result"
                                                    Command="{Binding DataContext.TestSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource ToolButton}" Content="Remove" Margin="0"
                                                    Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource H2}" FontSize="14" Text="{Binding Title}" />
                                                <Border Margin="10,0,0,0" CornerRadius="10" Padding="8,1" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource WarningSoft}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding HealthLabel}" FontSize="11.5">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsHealthy}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Success}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource MutedText}" Text="{Binding FeedUrl}" />
                                            <TextBlock Style="{StaticResource MutedText}" Text="{Binding Details}" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Warning}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <TextBlock Text="Priority" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Slider Width="160" Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                                        Value="{Binding Priority}" AutomationProperties.Name="Source priority" />
                                                <TextBlock Text="{Binding Priority}" Style="{StaticResource MutedText}" Width="30" Margin="6,0,16,0" VerticalAlignment="Center" />
                                                <CheckBox Content="Primary source (official announcements)" IsChecked="{Binding IsPrimary}" VerticalAlignment="Center"
                                                          Foreground="{DynamicResource Text}" ToolTip="Counts as direct evidence when ranking" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
