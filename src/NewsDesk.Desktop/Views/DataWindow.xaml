<Window x:Class="NewsDesk.Desktop.Views.DataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Data and backup" Width="680" SizeToContent="Height" MinHeight="400" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Bg}">
    <StackPanel Margin="28,20,28,24">
        <TextBlock Style="{StaticResource H2}" Text="Storage" />
        <TextBlock Style="{StaticResource Body}" Text="{Binding Usage}" Margin="0,6,0,0" />
        <TextBlock Style="{StaticResource MutedText}" Text="{Binding Counts}" Margin="0,2,0,0" />
        <DockPanel Margin="0,6,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="Open folder" Command="{Binding OpenDataFolderCommand}" Margin="8,0,0,0" Padding="10,3" />
            <TextBlock Style="{StaticResource MutedText}" Text="{Binding DataFolder}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </DockPanel>

        <TextBlock Style="{StaticResource H2}" Text="Cleanup" Margin="0,24,0,0" />
        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,8"
                   Text="Runs automatically once a day. Removes unreviewed items older than each project's retention period, and old briefings beyond the latest ten. Kept items, notes, tags, collections, and dismissals (so dismissed items stay hidden) are never removed." />
        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource ToolButton}" Content="Clean up now" Command="{Binding CleanUpCommand}" />
            <TextBlock Style="{StaticResource MutedText}" Text="{Binding LastCleanup}" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>

        <TextBlock Style="{StaticResource H2}" Text="Backup" Margin="0,24,0,0" />
        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,8"
                   Text="A backup is a single .zip with all projects, sources, collected articles, notes, tags, collections, briefings and settings. An automatic backup is made weekly (the last four are kept) in the backups folder on this PC — for protection against disk failure, also save a backup somewhere else, such as OneDrive or a USB drive." />
        <WrapPanel>
            <Button Style="{StaticResource PrimaryButton}" Content="Back up now…" Command="{Binding BackUpCommand}" Margin="0,0,6,6" />
            <Button Style="{StaticResource ToolButton}" Content="Restore from backup…" Command="{Binding RestoreCommand}" Margin="0,0,6,6" />
            <Button Style="{StaticResource ToolButton}" Content="Open backups folder" Command="{Binding OpenBackupFolderCommand}" Margin="0,0,6,6" />
        </WrapPanel>
        <TextBlock Style="{StaticResource MutedText}" Text="{Binding LastAutoBackup}" />

        <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,18,0,0" Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}">
            <TextBlock Style="{StaticResource Body}" FontSize="13" Text="{Binding Status}" />
        </Border>
        <ProgressBar Height="4" IsIndeterminate="True" Margin="0,10,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

        <Button Style="{StaticResource ToolButton}" Content="Close" HorizontalAlignment="Right" Margin="0,18,0,0" IsCancel="True" Click="OnClose" />
    </StackPanel>
</Window>
